# ═══════════════════════════════════════════════════════════
#  Caddyfile — FrankenPHP
#  FrankenPHP embarque Caddy : pas besoin de Nginx séparé.
#  Les variables {env.*} sont résolues depuis les vars d'env.
# ═══════════════════════════════════════════════════════════

{
    # Port admin Caddy (métriques Prometheus exposées ici)
    admin 0.0.0.0:2019

    # Activer les métriques Prometheus pour Caddy
    servers {
        metrics
    }

    # FrankenPHP global
    frankenphp {
        # Nombre de workers PHP (mode worker = pas de bootstrap à chaque requête)
        worker {
            file   /var/www/app/public/index.php
            num    4
            env    APP_RUNTIME_MODE worker
        }
    }
}

# ── Serveur principal ────────────────────────────────────
:{$SERVER_NAME:8080} {

    # Racine publique Symfony
    root * /var/www/app/public

    # Encode gzip/zstd
    encode zstd br gzip

    # PHP via FrankenPHP
    php_server {
        # Résolution correcte des chemins Symfony
        try_files {path} /index.php
    }

    # Headers de sécurité
    header {
        X-Content-Type-Options  nosniff
        X-Frame-Options         SAMEORIGIN
        Referrer-Policy         strict-origin-when-cross-origin
        -Server
    }

    # Logs structurés JSON → capturés par Promtail
    log {
        output stdout
        format json
        level  INFO
    }
}

# ── Métriques Caddy exposées pour Prometheus ─────────────
:2019 {
    metrics /metrics
}
