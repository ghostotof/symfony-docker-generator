{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Vue d'ensemble : HTTP, RabbitMQ, PostgreSQL, logs et traces",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🌐 HTTP — FrankenPHP / Caddy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total[1m])) by (handler)",
          "legendFormat": "{{ handler }}"
        }
      ],
      "title": "Requêtes / seconde",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "title": "Latences HTTP (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "min": 0,
          "thresholds": { "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total{status=~'5..'}[5m])) / sum(rate(caddy_http_requests_total[5m]))",
          "legendFormat": "Taux d'erreurs 5xx"
        }
      ],
      "title": "Taux d'erreurs HTTP 5xx",
      "type": "gauge"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "🐇 RabbitMQ",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{ queue }} — prêts"
        },
        {
          "expr": "rabbitmq_queue_messages_unacked",
          "legendFormat": "{{ queue }} — non-ackés"
        }
      ],
      "title": "Messages dans les files",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_channel_messages_published_total[1m])) by (queue)",
          "legendFormat": "{{ queue }} — publish/s"
        },
        {
          "expr": "sum(rate(rabbitmq_channel_messages_delivered_total[1m])) by (queue)",
          "legendFormat": "{{ queue }} — deliver/s"
        }
      ],
      "title": "Débit messages (publish / deliver)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "📋 Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "id": 20,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{job=~\"symfony|nextjs|rabbitmq|postgres\"}",
          "legendFormat": ""
        }
      ],
      "title": "Logs de la stack",
      "type": "logs"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 103,
      "title": "🔭 Traces (Tempo) — Service Map",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "id": 30,
      "options": { "nodes": { "mainStatUnit": "ms" } },
      "targets": [
        { "queryType": "serviceMap" }
      ],
      "title": "Service Map",
      "type": "nodeGraph"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["myapp", "overview"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MyApp — Overview",
  "uid":   "myapp-overview",
  "version": 1
}
